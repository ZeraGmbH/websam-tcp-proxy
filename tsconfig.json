{
  "compileOnSave": true,
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "inlineSources": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "outDir": "./build",
    "removeComments": true,
    "rootDir": "./host",
    "skipLibCheck": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "target": "ES2022"
  },
  "exclude": ["node_modules"],
  "include": ["host/**/*.ts", "webapp/src/common/**/*.d.ts"]
}
